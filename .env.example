# Copy to .env and fill in. Never commit .env.

# Required for Gemini models (default pipeline path)
GEMINI_API_KEY=

# Optional — Claude provider path
ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=
# ANTHROPIC_MODEL=

# Optional — regulations.gov API (DEMO_KEY works with low rate limits)
REGSGOV_API_KEY=
